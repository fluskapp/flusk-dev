{
	"name": "flusk",
	"version": "0.1.0",
	"type": "module",
	"description": "Autonomous coding agent that plans, edits and verifies its own work",
	"license": "Apache-2.0",
	"keywords": [
		"agent",
		"autonomous",
		"coding-agent",
		"llm",
		"cli"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/adirbenyossef/flusk.git"
	},
	"engines": {
		"node": ">=22.8"
	},
	"bin": {
		"flusk": "./dist/cli/main.js"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"standards": "bash scripts/check-standards.sh",
		"design": "bash scripts/check-design.sh",
		"dev": "npm run tokens && vite dev",
		"tokens": "npm run build && node scripts/gen-tokens.mjs",
		"build:app": "npm run tokens && vite build",
		"app": "npm run build:app && electron .",
		"pack": "npm run build && npm run build:app && electron-builder --dir",
		"dist": "npm run build && npm run build:app && electron-builder",
		"site": "npm run tokens && cp src/ui/react/tokens.css site/tokens.css && vite build --config site/vite.config.ts"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "^0.84.1",
		"@tanstack/react-router": "^1.170.27",
		"@tanstack/react-start": "^1.168.44",
		"@vitejs/plugin-react": "^5.2.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"typebox": "^1.1.24",
		"vite": "^7.3.6"
	},
	"optionalDependencies": {
		"@langchain/anthropic": "^1.5.4",
		"@langchain/core": "^1.2.5",
		"@langchain/langgraph": "^1.4.9",
		"langchain": "^1.5.5",
		"typescript": "^5.7.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@types/node": "^24.0.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"electron": "^43.4.0",
		"electron-builder": "^26.15.3",
		"vitest": "^3.0.0"
	},
	"homepage": "https://flusk.dev",
	"allowScripts": {
		"electron@43.4.0": true
	},
	"main": "electron/main.mjs",
	"build": {
		"appId": "dev.flusk.app",
		"productName": "flusk",
		"directories": {
			"output": "dist-pack"
		},
		"files": [
			"electron/**",
			"package.json"
		],
		"extraResources": [
			{
				"from": "dist",
				"to": "dist"
			},
			{
				"from": "dist-app",
				"to": "dist-app"
			},
			{
				"from": "src/platform/native/prebuilt",
				"to": "native"
			}
		],
		"mac": {
			"target": [
				"dmg"
			],
			"category": "public.app-category.developer-tools"
		},
		"win": {
			"target": [
				"nsis"
			]
		},
		"linux": {
			"target": [
				"AppImage"
			],
			"category": "Development"
		}
	}
}
