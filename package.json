{
	"name": "flusk",
	"version": "0.1.0",
	"type": "module",
	"description": "Autonomous coding agent that plans, edits and verifies its own work",
	"license": "Apache-2.0",
	"keywords": [
		"agent",
		"autonomous",
		"coding-agent",
		"llm",
		"cli"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/adirbenyossef/flusk.git"
	},
	"engines": {
		"node": ">=22.8"
	},
	"bin": {
		"flusk": "./dist/cli/main.js"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"standards": "bash scripts/check-standards.sh",
		"design": "bash scripts/check-design.sh"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "^0.84.1",
		"typebox": "^1.1.24"
	},
	"optionalDependencies": {
		"typescript": "^5.7.0",
		"@langchain/anthropic": "^1.5.4",
		"@langchain/core": "^1.2.5",
		"@langchain/langgraph": "^1.4.9",
		"langchain": "^1.5.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@types/node": "^24.0.0",
		"vitest": "^3.0.0"
	},
	"homepage": "https://flusk.dev"
}
